# Example Environment Configuration for Tenant Deployment
# Copy this file to .env and update with your tenant-specific values

# Required tenant configuration
VITE_TENANT_ID=example-tenant-123
VITE_TENANT_PRIMARY_COLOR=#3B82F6
VITE_TENANT_LOGO_URL=https://example.com/assets/logo.png
VITE_TENANT_COMPANY_NAME=Example Corporation
VITE_TENANT_API_URL=https://api.example.com

# Optional configuration (uncomment to override defaults)
# VITE_TENANT_SECONDARY_COLOR=#3B82F680
# VITE_TENANT_FAVICON_URL=https://example.com/assets/favicon.ico
# VITE_TENANT_API_TIMEOUT=10000
# VITE_TENANT_DEBUG=false

# Notes:
# - All VITE_ prefixed variables are exposed to the client-side code
# - Colors must be in hex format (#RRGGBB or #RGB)
# - URLs must be valid and include protocol (https:// or http://)
# - Boolean values: true, false, 1, or 0
# - API timeout is in milliseconds
# - Validation occurs at application startup - invalid values will prevent startup